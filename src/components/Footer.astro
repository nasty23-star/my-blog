---
const today = new Date();
---

<footer>
  <div class="ring-links">
    <p class="ring"><span class="code-class">code_</span><span>sisters</span> ring</p><a
      href="https://ladykosha.ru"
      target="_blank"
      >Agnessa's Blog
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
  <hr />
  &copy; {today.getFullYear()} Anastasia Yarosh. <span class="no-wrap">All rights reserved.</span>
  <div class="social-links">
    <a href="t.me/Okotw" target="_blank">
      <span class="sr-only">Find me in Telegram</span>
      <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
        ><path fill="currentColor" d="M13.5 2.5L1.5 6.5L5.5 9L12 4L7 10L10.5 13.5L13.5 2.5Z"
        ></path></svg
      >
    </a>
    <a href="https://github.com/nasty23-star" target="_blank">
      <span class="sr-only">Go to my GitHub repo</span>
      <svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
        ><path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        ></path></svg
      >
    </a>
  </div>
</footer>
<style>
  footer {
    padding: 1em 1em 1em 1em;
    border-top: 1px solid rgb(var(--gray));
    color: rgb(var(--gray));
    text-align: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 0.5em;
  }
  .social-links a {
    text-decoration: none;
    color: rgb(var(--gray));
  }
  .no-wrap {
    white-space: nowrap;
    display: inline-block;
  }

  .ring-links {
    display: flex;
    align-items: center;
    justify-content: space-evenly;
    margin-bottom: 1em;
  }

  .ring .code-class {
    color: #1db131;
  }

  .ring span {
    color: rgb(131, 85, 223);
  }

  .ring-links svg {
    top: 20px;
  }
</style>
