---
interface Props {
  data: Record<string, any>;
  format?: 'json' | 'css';
}

const { data, format = 'json' } = Astro.props;

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// --- Подсветка JSON в палитре DevTerminal ---

function highlightJSON(obj: any, indent = 0): string {
  const spaces = '  '.repeat(indent);
  const nextSpaces = '  '.repeat(indent + 1);
  const lines: string[] = [];

  if (Array.isArray(obj)) {
    if (obj.length === 0) return '<span class="br">[]</span>';
    lines.push('<span class="br">[</span>');
    obj.forEach((item, index) => {
      const isLast = index === obj.length - 1;
      const value = highlightJSON(item, indent + 1);
      lines.push(`${nextSpaces}${value}${isLast ? '' : '<span class="p">,</span>'}`);
    });
    lines.push(`${spaces}<span class="br">]</span>`);
    return lines.join('\n');
  }

  if (obj !== null && typeof obj === 'object') {
    const keys = Object.keys(obj);
    if (keys.length === 0) return '<span class="br">{}</span>';
    lines.push('<span class="br">{</span>');
    keys.forEach((key, index) => {
      const isLast = index === keys.length - 1;
      const value = highlightJSON(obj[key], indent + 1);
      const coloredKey = `<span class="key">"${escapeHtml(key)}"</span>`;
      lines.push(
        `${nextSpaces}${coloredKey}<span class="p">:</span> ${value}${isLast ? '' : '<span class="p">,</span>'}`
      );
    });
    lines.push(`${spaces}<span class="br">}</span>`);
    return lines.join('\n');
  }

  if (typeof obj === 'string') return `<span class="str">"${escapeHtml(obj)}"</span>`;
  if (typeof obj === 'number') return `<span class="num">${obj}</span>`;
  if (typeof obj === 'boolean') return `<span class="bool">${obj}</span>`;
  if (obj === null) return '<span class="null">null</span>';
  return `<span class="str">"${escapeHtml(String(obj))}"</span>`;
}

// --- Подсветка CSS в палитре DevTerminal ---

function highlightCSS(data: Record<string, any>): string {
  const entries = Object.entries(data);
  const lines: string[] = [];

  lines.push('<span class="sel">.facts</span> <span class="br">{</span>');

  entries.forEach(([key, value]) => {
    const prop = `<span class="key">${escapeHtml(key)}</span>`;
    const colon = '<span class="p">:</span>';

    let val: string;
    if (Array.isArray(value)) {
      val = value
        .map((v) => `<span class="str">"${escapeHtml(String(v))}"</span>`)
        .join('<span class="p">,</span> ');
    } else if (typeof value === 'number') {
      val = `<span class="num">${value}</span>`;
    } else if (typeof value === 'boolean') {
      val = `<span class="bool">${value}</span>`;
    } else {
      val = `<span class="str">"${escapeHtml(String(value))}"</span>`;
    }

    const semi = '<span class="p">;</span>';
    lines.push(`  ${prop}${colon} ${val}${semi}`);
  });

  lines.push('<span class="br">}</span>');
  return lines.join('\n');
}

const highlighted = format === 'json' ? highlightJSON(data) : highlightCSS(data);
---

<pre class="code-lcd"><code set:html={highlighted} /></pre>

<style is:global>
  /* ============================================================
     FactsCode — палитра DevTerminal (Night Owl, dark)
     ============================================================ */

  .code-lcd {
    margin: 0;
    padding: 15px;
    font-family: "JetBrains Mono", "Fira Code", "SF Mono", Menlo, Consolas,
      "Courier New", monospace;
    font-size: 14px;
    line-height: 1.5;
    overflow-x: auto;
    color: #d6deeb;
    background: #011627;
    border: 1px solid #1d3b53;
    border-radius: 10px;
    font-variant-ligatures: contextual;
    tab-size: 2;
    scrollbar-width: thin;
    scrollbar-color: #1d3b53 #011627;
  }

  .code-lcd code {
    font-family: inherit;
    white-space: pre;
  }

  /* --- Токены строго по палитре DevTerminal --- */

  /* Ключи JSON / свойства CSS — синий (.prompt-path, .dir, .git-branch-o) */
  .key {
    color: #82aaff;
  }

  /* Строки — песочный (.file-js, .file-json, .git-modified, .git-hash) */
  .str {
    color: #ecc48d;
  }

  /* Числа — зелёный (.prompt-user, .success, .git-staged, .file-vue) */
  .num {
    color: #addb67;
  }

  /* true / false — сиреневый (.git-branch) */
  .bool {
    color: #c792ea;
  }

  /* null — сиреневый курсив */
  .null {
    color: #c792ea;
    font-style: italic;
  }

  /* Скобки [ ] { } — основной текст (.cmd-text, .git-msg) */
  .br {
    color: #d6deeb;
  }

  /* Двоеточия, запятые, точки с запятой — приглушённый (.info, .git-date, .file-lock) */
  .p {
    color: #637777;
  }

  /* CSS-селектор — сиреневый (.git-branch) */
  .sel {
    color: #c792ea;
    font-weight: 600;
  }

  /* Скроллбар — как в .screen у DevTerminal */
  .code-lcd::-webkit-scrollbar {
    height: 8px;
  }
  .code-lcd::-webkit-scrollbar-track {
    background: #011627;
  }
  .code-lcd::-webkit-scrollbar-thumb {
    background: #1d3b53;
    border-radius: 4px;
  }
  .code-lcd::-webkit-scrollbar-thumb:hover {
    background: #2a4f6e;
  }

  @media (max-width: 640px) {
    .code-lcd {
      padding: 12px 14px;
      font-size: 12px;
    }
  }
</style>