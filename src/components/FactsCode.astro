---
interface Props {
  data: Record<string, any>;
  format?: 'json' | 'css';
}

const { data, format = 'json' } = Astro.props;

const output = format === 'json'
  ? JSON.stringify(data, null, 2)
  : Object.entries(data)
      .map(([k, v]) => `  ${k}: "${Array.isArray(v) ? v.join(', ') : v}";`)
      .join('\n')
      .replace(/^/, '.\n')
      .replace(/\.\n/, '.facts {\n') + '\n}';
---

<pre class="code-lcd"><code>{output}</code></pre>
