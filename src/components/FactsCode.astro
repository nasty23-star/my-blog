---
interface Props {
  data: Record<string, any>;
  format?: 'json' | 'css';
}

const { data, format = 'json' } = Astro.props;

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function highlightJSON(obj: any, indent = 0): string {
  const spaces = '  '.repeat(indent);
  const nextSpaces = '  '.repeat(indent + 1);
  const lines: string[] = [];

  if (Array.isArray(obj)) {
    if (obj.length === 0) return '<span class="fc-br">[]</span>';
    lines.push('<span class="fc-br">[</span>');
    obj.forEach((item, index) => {
      const isLast = index === obj.length - 1;
      const value = highlightJSON(item, indent + 1);
      lines.push(`${nextSpaces}${value}${isLast ? '' : '<span class="fc-p">,</span>'}`);
    });
    lines.push(`${spaces}<span class="fc-br">]</span>`);
    return lines.join('\n');
  }

  if (obj !== null && typeof obj === 'object') {
    const keys = Object.keys(obj);
    if (keys.length === 0) return '<span class="fc-br">{}</span>';
    lines.push('<span class="fc-br">{</span>');
    keys.forEach((key, index) => {
      const isLast = index === keys.length - 1;
      const value = highlightJSON(obj[key], indent + 1);
      const coloredKey = `<span class="fc-key">"${escapeHtml(key)}"</span>`;
      lines.push(
        `${nextSpaces}${coloredKey}<span class="fc-p">:</span> ${value}${isLast ? '' : '<span class="fc-p">,</span>'}`
      );
    });
    lines.push(`${spaces}<span class="fc-br">}</span>`);
    return lines.join('\n');
  }

  if (typeof obj === 'string') return `<span class="fc-str">"${escapeHtml(obj)}"</span>`;
  if (typeof obj === 'number') return `<span class="fc-num">${obj}</span>`;
  if (typeof obj === 'boolean') return `<span class="fc-bool">${obj}</span>`;
  if (obj === null) return '<span class="fc-null">null</span>';
  return `<span class="fc-str">"${escapeHtml(String(obj))}"</span>`;
}

function highlightCSS(data: Record<string, any>): string {
  const entries = Object.entries(data);
  const lines: string[] = [];

  lines.push('<span class="fc-sel">.facts</span> <span class="fc-br">{</span>');

  entries.forEach(([key, value]) => {
    const prop = `<span class="fc-key">${escapeHtml(key)}</span>`;
    const colon = '<span class="fc-p">:</span>';

    let val: string;
    if (Array.isArray(value)) {
      val = value
        .map((v) => `<span class="fc-str">"${escapeHtml(String(v))}"</span>`)
        .join('<span class="fc-p">,</span> ');
    } else if (typeof value === 'number') {
      val = `<span class="fc-num">${value}</span>`;
    } else if (typeof value === 'boolean') {
      val = `<span class="fc-bool">${value}</span>`;
    } else {
      val = `<span class="fc-str">"${escapeHtml(String(value))}"</span>`;
    }

    const semi = '<span class="fc-p">;</span>';
    lines.push(`  ${prop}${colon} ${val}${semi}`);
  });

  lines.push('<span class="fc-br">}</span>');
  return lines.join('\n');
}

const highlighted = format === 'json' ? highlightJSON(data) : highlightCSS(data);
---

<div class="facts-wrapper">
  <div class="facts-terminal">
    <div class="titlebar">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
      <span class="title">facts.{format === 'json' ? 'json' : 'css'} — zsh</span>
    </div>
    <pre class="screen"><code set:html={highlighted} /></pre>
  </div>
</div>

<style is:global>
  /* ============================================================
     FactsCode — Night Owl (dark по умолчанию) + Night Owl Light
     Переключение: класс .theme-light на <html> или родителе.
     ============================================================ */

  .facts-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .facts-terminal {
    /* ---- Dark (Night Owl) — значения по умолчанию ---- */
    --fc-bg: #011627;
    --fc-titlebar: #0b2942;
    --fc-border: #1d3b53;
    --fc-border-strong: #2a4f6e;
    --fc-fg: #d6deeb;
    --fc-title-fg: #b0b9b9;
    --fc-dot-red: #ff5f56;
    --fc-dot-yellow: #ffbd2e;
    --fc-dot-green: #27c93f;

    --fc-key: #82aaff;
    --fc-str: #679cc8;
    --fc-num: #addb67;
    --fc-bool: #c792ea;
    --fc-null: #c792ea;
    --fc-br: #d6deeb;
    --fc-p: #637777;
    --fc-sel: #c792ea;

    width: 100%;
    max-width: 850px;
    background: var(--fc-bg);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--fc-border);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  /* ---- Light (Night Owl Light) ---- */
  .theme-light .facts-terminal[data-theme='light'],
  [data-theme='light'] .facts-terminal {
    --fc-bg: #fbfbfb;
    --fc-titlebar: #f0f0f0;
    --fc-border: #d9d9d9;
    --fc-border-strong: #bcbcbc;
    --fc-fg: #403f53;
    --fc-title-fg: #6a6a7a;
    --fc-dot-red: #ff5f56;
    --fc-dot-yellow: #ffbd2e;
    --fc-dot-green: #27c93f;

    --fc-key: #994cc3;
    --fc-str: #4876d6;
    --fc-num: #aa0982;
    --fc-bool: #0c969b;
    --fc-null: #0c969b;
    --fc-br: #403f53;
    --fc-p: #5f5f7f;
    --fc-sel: #994cc3;
  }

  .facts-terminal .titlebar {
    height: 32px;
    background: var(--fc-titlebar);
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 8px;
    border-bottom: 1px solid var(--fc-border);
    flex-shrink: 0;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .facts-terminal .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .facts-terminal .dot.red {
    background: var(--fc-dot-red);
  }
  .facts-terminal .dot.yellow {
    background: var(--fc-dot-yellow);
  }
  .facts-terminal .dot.green {
    background: var(--fc-dot-green);
  }

  .facts-terminal .title {
    flex: 1;
    text-align: center;
    color: var(--fc-title-fg);
    font-size: 12px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  .facts-terminal .screen {
    margin: 0;
    padding: 15px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--fc-fg);
    background: var(--fc-bg);
    overflow-x: auto;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--fc-border) var(--fc-bg);
    font-family:
      'JetBrains Mono', 'Fira Code', 'SF Mono', Menlo, Consolas, 'Courier New', monospace;
    font-variant-ligatures: contextual;
    tab-size: 2;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .facts-terminal .screen code {
    font-family: inherit;
    white-space: pre;
  }

  .facts-terminal .screen::-webkit-scrollbar {
    height: 8px;
    width: 8px;
  }
  .facts-terminal .screen::-webkit-scrollbar-track {
    background: var(--fc-bg);
  }
  .facts-terminal .screen::-webkit-scrollbar-thumb {
    background: var(--fc-border);
    border-radius: 4px;
  }
  .facts-terminal .screen::-webkit-scrollbar-thumb:hover {
    background: var(--fc-border-strong);
  }

  /* ============================================================
     Токены подсветки — читают переменные, чтобы работать в обеих темах
     ============================================================ */

  .facts-terminal .fc-key {
    color: var(--fc-key);
  }
  .facts-terminal .fc-str {
    color: var(--fc-str);
  }
  .facts-terminal .fc-num {
    color: var(--fc-num);
  }
  .facts-terminal .fc-bool {
    color: var(--fc-bool);
  }
  .facts-terminal .fc-null {
    color: var(--fc-null);
    font-style: italic;
  }
  .facts-terminal .fc-br {
    color: var(--fc-br);
  }
  .facts-terminal .fc-p {
    color: var(--fc-p);
  }
  .facts-terminal .fc-sel {
    color: var(--fc-sel);
    font-weight: 600;
  }

  /* ============================================================
     Адаптив
     ============================================================ */
  @media (max-width: 640px) {
    .facts-terminal .screen {
      padding: 12px 14px;
      font-size: 12px;
    }
  }
</style>
