---
// DevTerminal.astro — интерактивный терминал с виртуальной FS проекта
---

<div class="terminal-wrapper" data-terminal>
  <div class="terminal" data-terminal-root>
    <div class="titlebar">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
      <span class="title">user@dev: ~/my-app</span>
    </div>

    <div class="screen" data-terminal-screen></div>

    <div class="input-line">
      <span class="prompt">
        <span class="prompt-user">user@dev</span><span class="prompt-symbol">:</span><span class="prompt-path" data-terminal-path>~/my-app</span><span class="prompt-symbol">$</span>
      </span>
      <input type="text" data-terminal-input autocomplete="off" spellcheck="false" />
    </div>
  </div>
</div>

<style>
  /* ============================================================
     VS Code Night Owl — dark
     ============================================================ */

  .terminal-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 2rem 0;
  }

  .terminal {
    width: 100%;
    max-width: 850px;
    height: 300px;
    background: #011627;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #1d3b53;
  }

  .titlebar {
    height: 32px;
    background: #0b2942;
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 8px;
    border-bottom: 1px solid #1d3b53;
    flex-shrink: 0;
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.red    { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green  { background: #27c93f; }

  .title {
    flex: 1;
    text-align: center;
    color: #b0b9b9;
    font-size: 12px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .screen {
    flex: 1;
    overflow-y: auto;
    padding: 15px;
    font-size: 14px;
    line-height: 1.5;
    color: #d6deeb;
    white-space: pre-wrap;
    word-break: break-word;
    scrollbar-width: thin;
    scrollbar-color: #1d3b53 #011627;
    font-family: "JetBrains Mono", "Fira Code", "SF Mono", Menlo, Consolas, "Courier New", monospace;
  }

  .screen::-webkit-scrollbar { width: 8px; }
  .screen::-webkit-scrollbar-track { background: #011627; }
  .screen::-webkit-scrollbar-thumb { background: #1d3b53; border-radius: 4px; }
  .screen::-webkit-scrollbar-thumb:hover { background: #2a4f6e; }

  .line { margin: 0; }

  .prompt-user   { color: #addb67; }
  .prompt-path   { color: #82aaff; }
  .prompt-symbol { color: #d6deeb; }
  .cmd-text      { color: #d6deeb; }

  .dir         { color: #82aaff; font-weight: 600; }
  .file-js     { color: #ecc48d; }
  .file-vue    { color: #addb67; font-weight: 600; }
  .file-json   { color: #ecc48d; }
  .file-md     { color: #d6deeb; }
  .file-config { color: #f78c6c; }
  .file-lock   { color: #637777; }

  .input-line {
    display: flex;
    align-items: center;
    padding: 0 15px 12px;
    font-size: 14px;
    flex-shrink: 0;
    font-family: "JetBrains Mono", "Fira Code", "SF Mono", Menlo, Consolas, "Courier New", monospace;
  }

  .input-line .prompt {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
    margin-right: 6px;
  }

  .input-line input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #d6deeb;
    font-family: inherit;
    font-size: 14px;
    caret-color: #7fdbca;
  }

  /* ---------- Semantic ---------- */
  .error   { color: #ef5350; }
  .info    { color: #637777; font-style: italic; }
  .success { color: #addb67; }

  /* ---------- Git colors (Night Owl) ---------- */
  .git-branch   { color: #c792ea; font-weight: 600; }
  .git-branch-o { color: #82aaff; }
  .git-modified { color: #ecc48d; }
  .git-staged   { color: #addb67; }
  .git-untracked{ color: #f78c6c; }
  .git-deleted  { color: #ef5350; }
  .git-hash     { color: #ecc48d; }
  .git-author   { color: #7fdbca; }
  .git-date     { color: #637777; }
  .git-msg      { color: #d6deeb; }
</style>

<script is:inline>
  (function () {
    'use strict';

    // ============================================================
    // Виртуальная файловая система проекта
    // ============================================================
    function createFS() {
      return {
        '~/my-app': {
          type: 'dir',
          children: {
            'node_modules':      { type: 'dir',  color: 'dir' },
            'public':            { type: 'dir',  color: 'dir' },
            'src':               { type: 'dir',  color: 'dir' },
            '.gitignore':        { type: 'file', color: 'file-md' },
            'index.html':        { type: 'file', color: 'file-md' },
            'package.json':      { type: 'file', color: 'file-json' },
            'package-lock.json': { type: 'file', color: 'file-lock' },
            'README.md':         { type: 'file', color: 'file-md' },
            'vite.config.js':    { type: 'file', color: 'file-config' },
            'tailwind.config.js':{ type: 'file', color: 'file-config' },
            '.env':              { type: 'file', color: 'file-config' },
          }
        },
        '~/my-app/src': {
          type: 'dir',
          children: {
            'assets':      { type: 'dir',  color: 'dir' },
            'components':  { type: 'dir',  color: 'dir' },
            'composables': { type: 'dir',  color: 'dir' },
            'router':      { type: 'dir',  color: 'dir' },
            'stores':      { type: 'dir',  color: 'dir' },
            'views':       { type: 'dir',  color: 'dir' },
            'App.vue':     { type: 'file', color: 'file-vue' },
            'main.js':     { type: 'file', color: 'file-js' },
            'style.css':   { type: 'file', color: 'file-md' },
          }
        },
        '~/my-app/src/components': {
          type: 'dir',
          children: {
            'Header.vue':      { type: 'file', color: 'file-vue' },
            'Footer.vue':      { type: 'file', color: 'file-vue' },
            'Sidebar.vue':     { type: 'file', color: 'file-vue' },
            'UserCard.vue':    { type: 'file', color: 'file-vue' },
            'TodoList.vue':    { type: 'file', color: 'file-vue' },
            'ModalDialog.vue': { type: 'file', color: 'file-vue' },
          }
        },
        '~/my-app/src/views': {
          type: 'dir',
          children: {
            'HomeView.vue':      { type: 'file', color: 'file-vue' },
            'AboutView.vue':     { type: 'file', color: 'file-vue' },
            'LoginView.vue':     { type: 'file', color: 'file-vue' },
            'DashboardView.vue': { type: 'file', color: 'file-vue' },
            'NotFound.vue':      { type: 'file', color: 'file-vue' },
          }
        },
        '~/my-app/src/composables': {
          type: 'dir',
          children: {
            'useAuth.js':         { type: 'file', color: 'file-js' },
            'useFetch.js':        { type: 'file', color: 'file-js' },
            'useLocalStorage.js': { type: 'file', color: 'file-js' },
          }
        },
        '~/my-app/src/stores': {
          type: 'dir',
          children: {
            'user.js':  { type: 'file', color: 'file-js' },
            'cart.js':  { type: 'file', color: 'file-js' },
            'theme.js': { type: 'file', color: 'file-js' },
          }
        },
        '~/my-app/src/router': {
          type: 'dir',
          children: {
            'index.js': { type: 'file', color: 'file-js' },
          }
        },
      };
    }

    // ============================================================
    // Виртуальный git-репозиторий
    // ============================================================
    function createGit() {
      return {
        branch: 'main',
        branches: ['main', 'feature/auth', 'feature/terminal', 'fix/styles'],
        staged: [
          { status: 'new',      file: 'src/components/Terminal.vue' },
          { status: 'modified', file: 'src/main.js' },
        ],
        modified: [
          { status: 'modified', file: 'src/App.vue' },
          { status: 'modified', file: 'package.json' },
          { status: 'deleted',  file: 'src/style.css' },
        ],
        untracked: [
          'src/composables/useGit.js',
          'src/stores/git.js',
          '.env.local',
        ],
        remote: {
          name: 'origin',
          url:  'git@github.com:user/my-app.git',
        },
        log: [
          { hash: 'a1b2c3d', author: 'Anastasia Yarosh', date: '2 hours ago', msg: 'feat: add git commands to dev terminal' },
          { hash: 'e4f5g6h', author: 'Leela Turanga',    date: 'yesterday',   msg: 'fix: correct prompt path resolution' },
          { hash: 'i7j8k9l', author: 'Bender Rodriguez', date: '3 days ago',  msg: 'refactor: extract FS into separate module' },
          { hash: 'm0n1o2p', author: 'Amy Wang',         date: '5 days ago',  msg: 'chore: initial project setup with Vite + Vue 3' },
        ],
      };
    }

    // ============================================================
    // Фейковые содержимые файлов (ВЫНЕСЕНЫ отдельно, чтобы
    // esbuild-сканер Vite не принял их за реальные импорты)
    // ============================================================
    const FAKE_FILES = {
      'package.json': [
        '{',
        '  "name": "my-app",',
        '  "version": "0.1.0",',
        '  "private": true,',
        '  "scripts": {',
        '    "dev": "vite",',
        '    "build": "vite build",',
        '    "preview": "vite preview"',
        '  },',
        '  "dependencies": {',
        '    "vue": "^3.4.0",',
        '    "vue-router": "^4.3.0",',
        '    "pinia": "^2.1.0",',
        '    "axios": "^1.6.0"',
        '  },',
        '  "devDependencies": {',
        '    "@vitejs/plugin-vue": "^5.0.0",',
        '    "vite": "^5.0.0",',
        '    "tailwindcss": "^3.4.0"',
        '  }',
        '}',
      ].join('\n'),

      // Строки ниже разбиты, чтобы esbuild не распознал их как импорты.
      // Символ '@' собран через конкатенацию, 'import' — тоже.
      'vite.config.js': [
        'imp' + 'ort { defineConfig } from "vite"',
        'imp' + 'ort vue from "@vitejs/' + 'plugin-vue"',
        'imp' + 'ort path from "path"',
        '',
        'export default defineConfig({',
        '  plugins: [vue()],',
        '  resolve: {',
        '    alias: { "@": path.resolve(__dirname, "./src") }',
        '  },',
        '  server: { port: 5173, open: true }',
        '})',
      ].join('\n'),

      'README.md': [
        '# My App',
        '',
        '## Установка',
        '```',
        'npm install',
        '```',
        '',
        '## Запуск dev-сервера',
        '```',
        'npm run dev',
        '```',
      ].join('\n'),
    };

    // ============================================================
    // Утилиты
    // ============================================================
    function esc(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // ============================================================
    // Инициализация одного терминала
    // ============================================================
    function initTerminal(wrapper) {
      if (!wrapper || wrapper.dataset.initialized === 'true') return;
      wrapper.dataset.initialized = 'true';

      const screen      = wrapper.querySelector('[data-terminal-screen]');
      const input       = wrapper.querySelector('[data-terminal-input]');
      const terminal    = wrapper.querySelector('[data-terminal-root]');
      const promptPath  = wrapper.querySelector('[data-terminal-path]');

      if (!screen || !input || !terminal || !promptPath) return;

      const fs  = createFS();
      const git = createGit();

      let cwd = '~/my-app';

      // -------------------- вывод --------------------
      function writeLine(html, className) {
        const div = document.createElement('div');
        div.className = className || 'line';
        // html формируется только из наших строк + esc() для пользовательских данных
        div.innerHTML = html;
        screen.appendChild(div);
        screen.scrollTop = screen.scrollHeight;
      }

      function promptHtml() {
        return '<span class="prompt-user">user@dev</span>'
             + '<span class="prompt-symbol">:</span>'
             + '<span class="prompt-path">' + esc(cwd) + '</span>'
             + '<span class="prompt-symbol">$</span>';
      }

      function showWelcome() {
        writeLine('<span class="info">dev terminal — v1.0.0</span>');
        writeLine('<span class="info">Введите <span class="success">help</span> для списка команд, <span class="success">ls</span> — для просмотра файлов.</span>');
        writeLine('');
      }

      // -------------------- пути --------------------
      function resolvePath(p) {
        if (!p || p === '~') return '~/my-app';

        // абсолютный: / или /src/... → ~/my-app[/...]
        if (p === '/') return '~/my-app';
        if (p.startsWith('/')) return '~/my-app' + p;

        // домашний: ~/...
        if (p.startsWith('~/')) return p;

        if (p === '.') return cwd;

        if (p === '..') {
          const parts = cwd.split('/');
          if (parts.length <= 1) return cwd;
          parts.pop();
          return parts.length === 1 ? parts[0] : parts.join('/');
        }

        // относительный
        return cwd === '~' ? '~/' + p : cwd + '/' + p;
      }

      // -------------------- ls --------------------
      function cmdLs(args) {
        const flags = args.filter(a => a.startsWith('-'));
        const paths = args.filter(a => !a.startsWith('-'));

        const showAll  = flags.some(f => f.includes('a'));
        const detailed = flags.some(f => f.includes('l'));

        const target = paths[0];
        const path   = target ? resolvePath(target) : cwd;

        if (!fs[path] || fs[path].type !== 'dir') {
          writeLine("ls: cannot access '" + esc(target || path) + "': No such file or directory", 'line error');
          return;
        }

        let items = Object.entries(fs[path].children || {});

        if (showAll) {
          items = [
            ['.',  { type: 'dir', color: 'dir' }],
            ['..', { type: 'dir', color: 'dir' }],
            ...items,
          ];
        } else {
          items = items.filter(([name]) => !name.startsWith('.'));
        }

        if (items.length === 0) return;

        if (detailed) {
          items.forEach(([name, info]) => {
            const perms  = info.type === 'dir' ? 'drwxr-xr-x' : '-rw-r--r--';
            const size   = info.type === 'dir' ? '4096' : String(1024 + (name.length * 137) % 8192);
            const date   = 'Sep 10 12:34';
            const cls    = info.color || (info.type === 'dir' ? 'dir' : 'file-js');
            const suffix = info.type === 'dir' ? '/' : '';
            writeLine(
              perms + '  user user ' + size.padStart(5) + ' ' + date + ' '
              + '<span class="' + cls + '">' + esc(name) + suffix + '</span>'
            );
          });
        } else {
          const names = items.map(([name, info]) => {
            const cls    = info.color || (info.type === 'dir' ? 'dir' : 'file-js');
            const suffix = info.type === 'dir' ? '/' : '';
            return '<span class="' + cls + '">' + esc(name) + suffix + '</span>';
          });
          writeLine(names.join('   '));
        }
      }

      // -------------------- cd --------------------
      function cmdCd(args) {
        const target = args[0];

        if (!target || target === '~' || target === '/') {
          cwd = '~/my-app';
        } else {
          const path = resolvePath(target);
          if (fs[path] && fs[path].type === 'dir') {
            cwd = path;
          } else {
            writeLine('cd: no such file or directory: ' + esc(target), 'line error');
            return;
          }
        }
        promptPath.textContent = cwd;
      }

      // -------------------- pwd --------------------
      function cmdPwd() {
        writeLine(esc(cwd.replace(/^~/, '/home/user')));
      }

      // -------------------- cat --------------------
      function cmdCat(args) {
        if (!args[0]) {
          writeLine('cat: missing file operand', 'line error');
          return;
        }
        const name = args[0];

        if (FAKE_FILES[name]) {
          // выводим как обычный текст, экранируя
          writeLine('<span class="file-md">' + esc(FAKE_FILES[name]) + '</span>');
          return;
        }

        const path = resolvePath(name);
        if (fs[path] && fs[path].type === 'file') {
          writeLine('<span class="info">(содержимое файла ' + esc(name) + ' не отображается в демо)</span>');
        } else {
          writeLine('cat: ' + esc(name) + ': No such file or directory', 'line error');
        }
      }

      // -------------------- tree --------------------
      function cmdTree(args) {
        const target = args[0];
        const path   = target ? resolvePath(target) : cwd;

        if (!fs[path] || fs[path].type !== 'dir') {
          writeLine('tree: ' + esc(target || path) + ': No such file or directory', 'line error');
          return;
        }

        writeLine('<span class="dir">' + esc(path.replace(/^~/, '.')) + '</span>');
        printTree(path, '', new Set());
      }

      function printTree(path, prefix, visited) {
        if (visited.has(path)) return;
        visited.add(path);

        const entries = Object.entries(fs[path] && fs[path].children || {})
          .filter(([n]) => !n.startsWith('.'));

        entries.forEach(([name, info], i) => {
          const last   = i === entries.length - 1;
          const branch = last ? '└── ' : '├── ';
          const cls    = info.color || (info.type === 'dir' ? 'dir' : 'file-js');
          const suffix = info.type === 'dir' ? '/' : '';
          writeLine(prefix + branch + '<span class="' + cls + '">' + esc(name) + suffix + '</span>');

          if (info.type === 'dir') {
            const newPath = path + '/' + name;
            if (fs[newPath]) {
              printTree(newPath, prefix + (last ? '    ' : '│   '), visited);
            }
          }
        });
      }

      // -------------------- git --------------------
      function cmdGit(args) {
        const sub = args[0];

        if (!sub) {
          writeLine('usage: git <command> [<args>]', 'line error');
          writeLine('Доступные подкоманды: <span class="success">status</span>, <span class="success">log</span>, <span class="success">branch</span>');
          return;
        }

        switch (sub) {
          case 'status': gitStatus(args.slice(1)); break;
          case 'log':    gitLog(args.slice(1));    break;
          case 'branch': gitBranch(args.slice(1)); break;
          default:
            writeLine("git: '" + esc(sub) + "' is not a git command. See 'git --help'.", 'line error');
            writeLine('Доступно: <span class="success">status</span>, <span class="success">log</span>, <span class="success">branch</span>');
        }
      }

      function gitStatus() {
        writeLine('On branch <span class="git-branch">' + esc(git.branch) + '</span>');
        writeLine("Your branch is up to date with <span class=\"git-branch-o\">'"
          + esc(git.remote.name) + '/' + esc(git.branch) + "'</span>.");
        writeLine('');

        if (git.staged.length) {
          writeLine('Changes to be committed:');
          writeLine('  (use "git restore --staged &lt;file&gt;..." to unstage)');
          git.staged.forEach(function (item) {
            const label = item.status === 'new' ? 'new file' : 'modified';
            writeLine('        <span class="git-staged">' + label + ':   ' + esc(item.file) + '</span>');
          });
          writeLine('');
        }

        if (git.modified.length) {
          writeLine('Changes not staged for commit:');
          writeLine('  (use "git add &lt;file&gt;..." to update what will be committed)');
          writeLine('  (use "git restore &lt;file&gt;..." to discard changes in working directory)');
          git.modified.forEach(function (item) {
            const label = item.status === 'deleted' ? 'deleted' : 'modified';
            const cls   = item.status === 'deleted' ? 'git-deleted' : 'git-modified';
            writeLine('        <span class="' + cls + '">' + label + ':   ' + esc(item.file) + '</span>');
          });
          writeLine('');
        }

        if (git.untracked.length) {
          writeLine('Untracked files:');
          writeLine('  (use "git add &lt;file&gt;..." to include in what will be committed)');
          git.untracked.forEach(function (file) {
            writeLine('        <span class="git-untracked">' + esc(file) + '</span>');
          });
          writeLine('');
        }

        if (!git.staged.length && !git.modified.length && !git.untracked.length) {
          writeLine('nothing to commit, working tree clean');
        } else {
          writeLine('no changes added to commit (use "git add" and/or "git commit -a")');
        }
      }

      function gitLog(args) {
        const oneline = args.includes('--oneline');
        let limit = git.log.length;

        // -n <N>
        const nIdx = args.indexOf('-n');
        if (nIdx !== -1 && args[nIdx + 1]) {
          const parsed = parseInt(args[nIdx + 1], 10);
          if (!isNaN(parsed) && parsed > 0) limit = parsed;
        }

        // -<N>
        for (const a of args) {
          if (/^-\d+$/.test(a)) {
            const parsed = parseInt(a.slice(1), 10);
            if (!isNaN(parsed) && parsed > 0) limit = parsed;
            break;
          }
        }

        const entries = git.log.slice(0, limit);

        if (oneline) {
          entries.forEach(function (c) {
            writeLine('<span class="git-hash">' + esc(c.hash) + '</span> <span class="git-msg">' + esc(c.msg) + '</span>');
          });
          return;
        }

        entries.forEach(function (c, i) {
          writeLine('<span class="git-hash">commit ' + esc(c.hash) + '</span>');
          writeLine('Author: <span class="git-author">' + esc(c.author) + '</span>');
          writeLine('Date:   <span class="git-date">' + esc(c.date) + '</span>');
          writeLine('');
          writeLine('    <span class="git-msg">' + esc(c.msg) + '</span>');
          if (i < entries.length - 1) writeLine('');
        });
      }

      function gitBranch(args) {
        const showAll = args.includes('-a') || args.includes('--all');
        const verbose = args.includes('-v') || args.includes('--verbose');
        const remote  = args.includes('-r') || args.includes('--remotes');

        let list = git.branches.slice();
        if (showAll || remote) {
          list.push('remotes/' + git.remote.name + '/' + git.branch);
        }

        list.forEach(function (name) {
          const isCurrent = name === git.branch;
          const prefix    = isCurrent ? '* ' : '  ';
          const cls       = isCurrent ? 'git-branch' : 'git-branch-o';
          let suffix = '';
          if (verbose && isCurrent && git.log[0]) {
            suffix = '  <span class="git-hash">' + esc(git.log[0].hash) + '</span> '
                   + '<span class="git-msg">' + esc(git.log[0].msg) + '</span>';
          }
          writeLine(prefix + '<span class="' + cls + '">' + esc(name) + '</span>' + suffix);
        });
      }

      // -------------------- help / clear --------------------
      function cmdHelp() {
        writeLine('<span class="success">Доступные команды:</span>');
        writeLine('  <span class="dir">ls</span> [path]        — список файлов в директории');
        writeLine('  <span class="dir">ls -la</span> [path]    — подробный список, включая скрытые');
        writeLine('  <span class="dir">cd</span> &lt;dir&gt;          — перейти в директорию');
        writeLine('  <span class="dir">pwd</span>               — текущая директория');
        writeLine('  <span class="dir">cat</span> &lt;file&gt;        — показать содержимое файла');
        writeLine('  <span class="dir">tree</span> [path]       — дерево проекта');
        writeLine('  <span class="dir">git status</span>        — состояние рабочей директории');
        writeLine('  <span class="dir">git log</span>           — история коммитов');
        writeLine('  <span class="dir">git branch</span>        — список веток');
        writeLine('  <span class="dir">clear</span>             — очистить экран');
        writeLine('  <span class="dir">help</span>              — эта справка');
        writeLine('');
      }

      function cmdClear() {
        screen.innerHTML = '';
      }

      // -------------------- диспетчер --------------------
      function runCommand(raw) {
        writeLine(promptHtml() + ' <span class="cmd-text">' + esc(raw) + '</span>');

        const parts = raw.trim().split(/\s+/);
        const cmd   = parts[0];
        const args  = parts.slice(1);

        switch (cmd) {
          case '':      break;
          case 'ls':    cmdLs(args);   break;
          case 'cd':    cmdCd(args);   break;
          case 'pwd':   cmdPwd();      break;
          case 'cat':   cmdCat(args);  break;
          case 'tree':  cmdTree(args); break;
          case 'git':   cmdGit(args);  break;
          case 'help':  cmdHelp();     break;
          case 'clear': cmdClear();    break;
          case 'echo':  writeLine(esc(args.join(' '))); break;
          default:
            writeLine('command not found: ' + esc(cmd) + '. Введите <span class="success">help</span> для списка команд.', 'line error');
        }
      }

      // -------------------- история команд --------------------
      const history = [];
      let histIndex = -1;

      const controller = new AbortController();
      const signal = controller.signal;

      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          const value = input.value;
          if (value.trim()) {
            history.push(value);
            histIndex = history.length;
          }
          runCommand(value);
          input.value = '';
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (histIndex > 0) {
            histIndex--;
            input.value = history[histIndex] || '';
          }
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (histIndex < history.length - 1) {
            histIndex++;
            input.value = history[histIndex];
          } else {
            histIndex = history.length;
            input.value = '';
          }
        } else if (e.key === 'l' && e.ctrlKey) {
          e.preventDefault();
          cmdClear();
        }
      }, { signal: signal });

      terminal.addEventListener('click', function () {
        input.focus();
      }, { signal: signal });

      // Сохраняем контроллер на элементе, чтобы можно было отменить при размонтировании
      wrapper._terminalController = controller;

      showWelcome();
    }

    // ============================================================
    // Инициализация всех терминалов на странице
    // ============================================================
    function initAll() {
      document.querySelectorAll('[data-terminal]').forEach(initTerminal);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll, { once: true });
    } else {
      initAll();
    }

    // Astro View Transitions: этот хук вызывается и при первой загрузке,
    // и при каждом переходе. Дублирование не нужно.
    document.addEventListener('astro:page-load', initAll);
  })();
</script>