---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Sparkle from '@components/Sparkle.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { Image } from 'astro:assets';
import '@styles/global.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- Космический фон -->
    <div class="space-bg">
      <div class="stars"></div>
      <div class="twinkling-stars"></div>
      <div class="nebula"></div>
    </div>

    <Header />
    <main>
      <section class="hero">
        <div class="hero-content">
          <div class="hero-text">
            <span class="greeting"><Sparkle /> Hello, my name is <Sparkle /></span>
            <h1>Anastasia</h1>
            <p class="description">
              frontend developer, contributor,<br />
              open-source enthusiast
            </p>
          </div>
          <div class="hero-image"></div>
        </div>
      </section>

      <section class="terminal-section">
        <div class="terminal-header">
          <div class="terminal-controls">
            <span class="control red"></span>
            <span class="control yellow"></span>
            <span class="control green"></span>
          </div>
          <span class="terminal-title">>_ SPACECRAFT_TECH_STACK.FRONTEND</span>
        </div>

        <div class="terminal-body" id="terminalBody">
          <!-- Строки Matrix вставит скрипт -->

          <!-- Команда: изначально скрыта -->
          <div class="terminal-line command-line is-hidden">
            <span class="prompt">$</span>
            <span class="command command-typed"></span>
          </div>

          <!-- Сетка технологий: изначально скрыта -->
          <div class="terminal-output is-hidden" id="techOutput">
            <div class="tech-grid">
              <div class="tech-item"><span class="tech-name">JavaScript</span></div>
              <div class="tech-item"><span class="tech-name">Vue.js</span></div>
              <div class="tech-item"><span class="tech-name">React</span></div>
              <div class="tech-item"><span class="tech-name">Next.js</span></div>
              <div class="tech-item"><span class="tech-name">Astro</span></div>
              <div class="tech-item"><span class="tech-name">TypeScript</span></div>
              <div class="tech-item"><span class="tech-name">CSS</span></div>
              <div class="tech-item"><span class="tech-name">Git</span></div>
              <div class="tech-item"><span class="tech-name">Vite</span></div>
              <div class="tech-item"><span class="tech-name">pnpm</span></div>
              <div class="tech-item"><span class="tech-name">npm</span></div>
              <div class="tech-item"><span class="tech-name">Tailwind</span></div>
              <div class="tech-item"><span class="tech-name">Telegram Mini Apps</span></div>
              <div class="tech-item"><span class="tech-name">Cursor</span></div>
              <div class="tech-item"><span class="tech-name">Claude</span></div>
            </div>
          </div>

          <!-- Финальный курсор: изначально скрыт -->
          <div class="terminal-line final-line is-hidden">
            <span class="prompt">$</span>
            <span class="command blink">_</span>
          </div>
        </div>

        <div class="terminal-footer">
          <span class="status">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 6L9 17L4 12" stroke="#27c93f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="12" cy="12" r="10" stroke="#27c93f" stroke-width="1.5" stroke-opacity="0.3"></circle>
            </svg>
            SYSTEM READY
          </span>
          <span class="status">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="4" width="18" height="16" rx="2" stroke="#60a5fa" stroke-width="1.8"></rect>
              <path d="M8 2v4M16 2v4" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="2" fill="#60a5fa" stroke="#60a5fa" stroke-width="1.5"></circle>
              <path d="M12 14v4" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            8 MODULES LOADED
          </span>
          <span class="status">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="3" fill="#27c93f" stroke="#27c93f" stroke-width="1.5"></circle>
              <circle cx="12" cy="12" r="3" fill="#27c93f" stroke="#27c93f" stroke-width="1.5">
                <animate attributeName="opacity" values="1;0.3;1" dur="2s" repeatCount="indefinite"></animate>
              </circle>
            </svg>
            SIGNAL: STABLE
          </span>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('terminalBody');
        if (!container) return;

        const output = document.getElementById('techOutput');
        const commandLine = container.querySelector('.command-line');
        const commandSpan = container.querySelector('.command-typed');
        const finalLine = container.querySelector('.final-line');
        const anchor = commandLine;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ==== REDUCED MOTION: показываем всё сразу, без анимаций ====
        if (prefersReduced) {
          commandLine.classList.remove('is-hidden');
          commandSpan.textContent = 'pnpm list --skills --depth=0';
          commandLine.classList.add('done'); // убираем курсор у команды
          output.classList.remove('is-hidden'); // скиллы сразу
          finalLine.classList.remove('is-hidden');
          return;
        }

        // ==== ОБЫЧНЫЙ РЕЖИМ: полный сценарий ====
        const phraseLines = [
          { text: 'Wake up, Neo...', pauseAfter: 800 },
          { text: 'Matrix has you.', pauseAfter: 800 },
          { text: 'Follow the white rabbit.', pauseAfter: 1000 },
        ];

        const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

        async function typeInto(span, text, speed = 60) {
          span.textContent = '';
          for (const char of text) {
            span.textContent += char;
            await sleep(speed);
          }
        }

        async function typeNewLine(text, speed = 60) {
          const line = document.createElement('div');
          line.className = 'terminal-line matrix-line';
          const span = document.createElement('span');
          span.className = 'matrix-typed';
          line.appendChild(span);
          container.insertBefore(line, anchor);

          await typeInto(span, text, speed);
          await sleep(300);
        }

        function revealTechGrid() {
          output.classList.remove('is-hidden');
          const items = output.querySelectorAll('.tech-item');
          items.forEach((item, i) => {
            item.style.animationDelay = `${i * 70}ms`;
          });
        }

        async function run() {
          // 1. Фразы Matrix
          for (const { text, pauseAfter } of phraseLines) {
            await sleep(pauseAfter);
            await typeNewLine(text, 55);
          }

          // 2. Команда
          await sleep(600);
          commandLine.classList.remove('is-hidden');
          await typeInto(commandSpan, 'pnpm list --skills --depth=0', 45);

          // 3. Пауза «выполнения» и убираем курсор у команды
          await sleep(500);
          commandLine.classList.add('done');

          // 4. Только теперь — скиллы
          revealTechGrid();

          // 5. Финальный курсор
          await sleep(900);
          finalLine.classList.remove('is-hidden');
        }

        run();
      });
    </script>
  </body>
</html>

<style>
  /* === КОСМИЧЕСКИЙ ФОН === */
  .space-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    overflow: hidden;
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(2px 2px at 10px 30px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 80px 200px, #f8f9fa, rgba(0, 0, 0, 0)),
      radial-gradient(3px 3px at 250px 150px, #e0e7ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 400px 80px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 550px 320px, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 700px 120px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 850px 450px, #e0e7ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 1000px 250px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(3px 3px at 1150px 600px, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 1300px 100px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 200px 500px, #e0e7ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 600px 700px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 900px 800px, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 1100px 550px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(3px 3px at 1450px 350px, #e0e7ff, rgba(0, 0, 0, 0));
    background-repeat: no-repeat;
    background-size: 1500px 1000px;
    opacity: 0.9;
    animation: starDrift 120s linear infinite;
  }

  .twinkling-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(1px 1px at 15% 25%, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 45% 65%, #f0f9ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 75% 15%, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 25% 80%, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 60% 40%, #fff, rgba(0, 0, 0, 0));
    background-repeat: no-repeat;
    animation: twinkle 3s ease-in-out infinite alternate;
  }

  .nebula {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 30% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 70% 60%, rgba(139, 92, 246, 0.06) 0%, transparent 50%);
    animation: nebulaDrift 40s ease-in-out infinite alternate;
  }

  @keyframes starDrift {
    0% { transform: translateX(0) translateY(0); }
    100% { transform: translateX(-50px) translateY(-30px); }
  }

  @keyframes twinkle {
    0% { opacity: 0.3; }
    100% { opacity: 1; }
  }

  @keyframes nebulaDrift {
    0% { transform: scale(1) translateX(0); opacity: 0.5; }
    100% { transform: scale(1.05) translateX(2%); opacity: 0.7; }
  }

  /* === СТИЛИ ТЕРМИНАЛА === */
  .terminal-section {
    max-width: 900px;
    margin: 0.5rem auto;
    border-radius: 12px;
    overflow: hidden;
    font-family: 'Courier New', 'Fira Code', monospace;
    border: 1px solid #1e3a5f;
  }

  .terminal-header {
    padding: 0.8rem 1rem;
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid #1e3a5f;
  }

  .terminal-controls {
    display: flex;
    gap: 0.5rem;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .control.red { background: #ff5f56; }
  .control.yellow { background: #ffbd2e; }
  .control.green { background: #27c93f; }

  .terminal-title {
    font-size: 0.85rem;
    letter-spacing: 0.5px;
  }

  .terminal-body {
    backdrop-filter: blur(4px);
    padding: 1.5rem;
    border-bottom: 1px solid #1e3a5f;
    min-height: 240px;
  }

  .terminal-line {
    margin-bottom: 0.8rem;
  }

  .terminal-line.command-line.done {
    /* margin-top: 1.5rem; */
  }

  .prompt {
    font-weight: bold;
    margin-right: 0.5rem;
  }

  .terminal-output {
    margin: 0;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.4rem 1rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .tech-name {
    flex: 1;
    font-weight: 500;
  }

  .blink {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* === MATRIX-ЭФФЕКТЫ === */
  .is-hidden {
    display: none;
  }

  .terminal-line.matrix-line {
    margin-bottom: 0.4rem;
    color: #27c93f;
  }

  .terminal-line .matrix-typed {
    color: #27c93f;
    font-family: 'Courier New', monospace;
    letter-spacing: 1px;
    text-shadow: 0 0 8px rgba(39, 201, 63, 0.7);
  }

  .matrix-typed::after {
    content: '_';
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    color: #27c93f;
  }

  .command-typed::after {
    content: '_';
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    color: inherit;
  }

  .command-line.done .command-typed::after {
    content: '';
  }

  .terminal-output {
    animation: techReveal 0.5s ease-out;
  }

  @keyframes techReveal {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tech-item {
    opacity: 0;
    animation: techItemIn 0.35s ease-out forwards;
  }

  @keyframes techItemIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* === СТАТУС-БАР === */
  .terminal-footer {
    padding: 0.6rem 1rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.7rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Courier New', monospace;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .status-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* === HERO === */
  .hero {
    padding: 1rem 1rem;
    max-width: 1200px;
    margin: 60px auto 0;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .hero-text {
    flex: 1;
    min-width: 280px;
  }

  .hero-image {
    flex-shrink: 0;
  }

  .hero-image img {
    border-radius: 50%;
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.3);
    object-fit: cover;
  }

  .greeting {
    display: inline-block;
    font-size: 1rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: 4rem;
    margin: 0 0 0.5rem 0;
    background-clip: text;
    -webkit-background-clip: text;
    line-height: 1.2;
  }

  .description {
    font-size: 1.2rem;
    line-height: 1.6;
    height: 94px;
  }

  /* === АДАПТИВ === */
  @media (max-width: 420px) {
    .terminal-title { letter-spacing: 0.2px; }
  }

  @media (max-width: 768px) {
    .hero { padding: 1rem; }
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }
    h1 { font-size: 2.5rem; }
    .description { font-size: 1rem; }
    .hero-image img { width: 200px; height: 200px; }
    .tech-grid { grid-template-columns: 1fr; }
  }

  /* === FALLBACK: prefers-reduced-motion === */
  @media (prefers-reduced-motion: reduce) {
    /* Космический фон — без анимаций */
    .stars,
    .twinkling-stars,
    .nebula {
      animation: none !important;
    }

    /* Скиллы видны сразу */
    .terminal-output,
    .terminal-output.is-hidden {
      display: block !important;
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    /* Элементы сетки без каскада */
    .tech-item {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }

    /* Команда показывается статично, без курсора-печати */
    .command-line.is-hidden {
      display: block !important;
    }

    .command-typed::after,
    .matrix-typed::after {
      animation: none !important;
      opacity: 1 !important;
    }

    /* Финальный курсор не мигает */
    .blink {
      animation: none !important;
    }
  }
</style>