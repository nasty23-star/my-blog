---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Sparkle from '@components/Sparkle.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { Image } from 'astro:assets';
import '@styles/global.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <!-- Космический фон -->
    <div class="space-bg">
      <div class="stars"></div>
      <div class="twinkling-stars"></div>
      <div class="nebula"></div>
    </div>

    <Header />
    <main>
      <section class="hero">
        <div class="hero-content">
          <div class="hero-text">
            <span class="greeting"><Sparkle /> Hello, my name is <Sparkle /></span>
            <h1>Anastasia</h1>
            <p class="description">
              frontend developer, contributor,<br />
              open-source enthusiast
            </p>
          </div>
          <div class="hero-image"></div>
        </div>
      </section>

      <section class="terminal-section">
        <div class="terminal-header">
          <div class="terminal-controls">
            <span class="control red"></span>
            <span class="control yellow"></span>
            <span class="control green"></span>
          </div>
          <span class="terminal-title" id="terminalTitle">>_ SPACECRAFT_TECH_STACK.FRONTEND</span>
        </div>

        <div class="terminal-body" id="terminalBody">
          <!-- Строки Matrix вставит скрипт -->

          <!-- Команда: изначально скрыта -->
          <div class="terminal-line command-line is-hidden">
            <span class="prompt">$</span>
            <span class="command command-typed"></span>
          </div>

          <!-- Прогресс-бар: изначально скрыт -->
          <div class="terminal-line progress-line is-hidden" id="progressLine">
            <span class="progress-typed matrix-typed"></span>
          </div>

          <!-- Сетка технологий: изначально скрыта -->
          <div class="terminal-output is-hidden" id="techOutput">
            <div class="tech-grid">
              <div class="tech-item"><span class="tech-name">JavaScript</span></div>
              <div class="tech-item"><span class="tech-name">Vue.js</span></div>
              <div class="tech-item"><span class="tech-name">React</span></div>
              <div class="tech-item"><span class="tech-name">Next.js</span></div>
              <div class="tech-item"><span class="tech-name">Astro</span></div>
              <div class="tech-item"><span class="tech-name">TypeScript</span></div>
              <div class="tech-item"><span class="tech-name">CSS</span></div>
              <div class="tech-item"><span class="tech-name">Git</span></div>
              <div class="tech-item"><span class="tech-name">Vite</span></div>
              <div class="tech-item"><span class="tech-name">pnpm</span></div>
              <div class="tech-item"><span class="tech-name">npm</span></div>
              <div class="tech-item"><span class="tech-name">Tailwind</span></div>
              <div class="tech-item"><span class="tech-name">Telegram Mini Apps</span></div>
              <div class="tech-item"><span class="tech-name">Cursor</span></div>
              <div class="tech-item"><span class="tech-name">Claude</span></div>
            </div>
          </div>

          <!-- Финальный курсор: изначально скрыт -->
          <div class="terminal-line final-line is-hidden">
            <span class="prompt">$</span>
            <span class="command blink">_</span>
          </div>
        </div>

        <div class="terminal-footer">
          <span class="status">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 6L9 17L4 12" stroke="#27c93f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="12" cy="12" r="10" stroke="#27c93f" stroke-width="1.5" stroke-opacity="0.3"></circle>
            </svg>
            SYSTEM READY
          </span>
          <span class="status">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="4" width="18" height="16" rx="2" stroke="#60a5fa" stroke-width="1.8"></rect>
              <path d="M8 2v4M16 2v4" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="2" fill="#60a5fa" stroke="#60a5fa" stroke-width="1.5"></circle>
              <path d="M12 14v4" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
            8 MODULES LOADED
          </span>
          <span class="status">
            <svg class="status-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" stroke="#60a5fa" stroke-width="1.8" stroke-linecap="round"></path>
              <circle cx="12" cy="12" r="3" fill="#27c93f" stroke="#27c93f" stroke-width="1.5"></circle>
              <circle cx="12" cy="12" r="3" fill="#27c93f" stroke="#27c93f" stroke-width="1.5">
                <animate attributeName="opacity" values="1;0.3;1" dur="2s" repeatCount="indefinite"></animate>
              </circle>
            </svg>
            SIGNAL: STABLE
          </span>
        </div>
      </section>
    </main>
    <Footer />

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('terminalBody');
        if (!container) return;

        const output = document.getElementById('techOutput');
        const commandLine = container.querySelector('.command-line');
        const commandSpan = container.querySelector('.command-typed');
        const progressLine = document.getElementById('progressLine');
        const progressSpan = container.querySelector('.progress-typed');
        const finalLine = container.querySelector('.final-line');
        const terminalTitle = document.getElementById('terminalTitle');
        const anchor = commandLine;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // ==== Ключ localStorage ====
        const STORAGE_KEY = 'terminal_animation_seen';

        // Безопасные обёртки (в приватном режиме localStorage может падать)
        function safeGet(key) {
          try { return window.localStorage.getItem(key); } catch { return null; }
        }
        function safeSet(key, value) {
          try { window.localStorage.setItem(key, value); } catch { /* ignore */ }
        }

        const alreadySeen = safeGet(STORAGE_KEY) === '1';

        // ==== Статичный рендер (для reduced-motion или повторного визита) ====
        function renderStatic() {
          // Заголовок финальный
          terminalTitle.textContent = '>_ ANASTASIA.TECH_STACK.FRONTEND';

          // Команда
          commandLine.classList.remove('is-hidden');
          commandSpan.textContent = 'pnpm list --skills --depth=0';
          commandLine.classList.add('done');

          // Прогресс 100%
          progressLine.classList.remove('is-hidden');
          progressSpan.textContent = '[████████████████████] 100% ✓';

          // Скиллы сразу
          output.classList.remove('is-hidden');
          const items = output.querySelectorAll('.tech-item');
          items.forEach((item) => {
            item.style.opacity = '1';
            item.style.transform = 'none';
            item.style.animation = 'none';
          });

          // Финальный курсор
          finalLine.classList.remove('is-hidden');

          // Отключаем анимации у самого терминала, чтобы ничего не «моргало»
          container.classList.add('no-anim');
        }

        // ==== REDUCED MOTION или ПОВТОРНЫЙ ВИЗИТ: всё сразу ====
        if (prefersReduced || alreadySeen) {
          renderStatic();
          return;
        }

        // ==== ПЕРВЫЙ ВИЗИТ: полный сценарий ====
        const phraseLines = [
          { text: 'Wake up, Neo...',           pauseAfter: 800,  type: 'matrix' },
          { text: 'Matrix has you.',           pauseAfter: 800,  type: 'matrix' },
          { text: 'Follow the white rabbit.',  pauseAfter: 1000, type: 'matrix' },

          { text: '...',                       pauseAfter: 1200, type: 'dim' },

          {
            text: '> Operator identified: NOT NEO',
            pauseAfter: 400,
            type: 'system',
            glitch: true,
            newTitle: '>_ NEO_PROFILE.SCAN — FAILED',
          },

          { text: '> Scanning alternate profile...', pauseAfter: 700, type: 'system' },

          {
            text: '> Candidate: ANASTASIA',
            pauseAfter: 900,
            type: 'system',
            newTitle: '>_ ANASTASIA.TECH_STACK.FRONTEND',
          },
        ];

        const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

        async function typeInto(span, text, speed = 60) {
          span.textContent = '';
          for (const char of text) {
            span.textContent += char;
            await sleep(speed);
          }
        }

        async function typeNewLine(text, speed = 60, type = 'matrix') {
          const line = document.createElement('div');
          line.className = `terminal-line matrix-line type-${type}`;

          const span = document.createElement('span');
          span.className = 'matrix-typed';
          line.appendChild(span);
          container.insertBefore(line, anchor);

          await typeInto(span, text, speed);
          await sleep(300);
        }

        function glitchTerminal(duration = 400) {
          container.classList.add('glitching');
          terminalTitle.classList.add('glitching');
          setTimeout(() => {
            container.classList.remove('glitching');
            terminalTitle.classList.remove('glitching');
          }, duration);
        }

        async function runProgressBar() {
          const total = 20;
          const stepDelay = 60;

          for (let i = 0; i <= total; i++) {
            const filled = '█'.repeat(i);
            const empty = '░'.repeat(total - i);
            const pct = Math.round((i / total) * 100);
            progressSpan.textContent = `[${filled}${empty}] ${pct}%`;
            await sleep(stepDelay);
          }

          progressSpan.textContent = '[████████████████████] 100% ✓';
          await sleep(400);
        }

        function revealTechGrid() {
          output.classList.remove('is-hidden');
          const items = output.querySelectorAll('.tech-item');
          items.forEach((item, i) => {
            item.style.animationDelay = `${i * 70}ms`;
          });
        }

        async function run() {
          // Флаг «поставь галочку после завершения» — на случай,
          // если пользователь закроет страницу в середине.
          // Ставим ДО запуска, чтобы не перезапускать при быстром reload.
          // (Если хочешь ставить в самом конце — перенеси в конец run().)
          safeSet(STORAGE_KEY, '1');

          for (const phrase of phraseLines) {
            await sleep(phrase.pauseAfter);

            if (phrase.glitch) {
              glitchTerminal(400);
              await sleep(200);
            }

            if (phrase.newTitle) {
              terminalTitle.textContent = phrase.newTitle;
            }

            const speed = phrase.type === 'matrix' ? 55 : 40;
            await typeNewLine(phrase.text, speed, phrase.type);
          }

          await sleep(600);
          commandLine.classList.remove('is-hidden');
          await typeInto(commandSpan, 'pnpm list --skills --depth=0', 45);

          await sleep(500);
          commandLine.classList.add('done');

          progressLine.classList.remove('is-hidden');
          await runProgressBar();

          revealTechGrid();

          await sleep(900);
          finalLine.classList.remove('is-hidden');
        }

        run();
      });
    </script>
  </body>
</html>

<style>
  /* === КОСМИЧЕСКИЙ ФОН === */
  .space-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    overflow: hidden;
  }

  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(2px 2px at 10px 30px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 80px 200px, #f8f9fa, rgba(0, 0, 0, 0)),
      radial-gradient(3px 3px at 250px 150px, #e0e7ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 400px 80px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 550px 320px, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 700px 120px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 850px 450px, #e0e7ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 1000px 250px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(3px 3px at 1150px 600px, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 1300px 100px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 200px 500px, #e0e7ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 600px 700px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 900px 800px, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 1100px 550px, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(3px 3px at 1450px 350px, #e0e7ff, rgba(0, 0, 0, 0));
    background-repeat: no-repeat;
    background-size: 1500px 1000px;
    opacity: 0.9;
    animation: starDrift 120s linear infinite;
  }

  .twinkling-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image:
      radial-gradient(1px 1px at 15% 25%, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 45% 65%, #f0f9ff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 75% 15%, #fff, rgba(0, 0, 0, 0)),
      radial-gradient(1px 1px at 25% 80%, #bae6fd, rgba(0, 0, 0, 0)),
      radial-gradient(2px 2px at 60% 40%, #fff, rgba(0, 0, 0, 0));
    background-repeat: no-repeat;
    animation: twinkle 3s ease-in-out infinite alternate;
  }

  .nebula {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 30% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 70% 60%, rgba(139, 92, 246, 0.06) 0%, transparent 50%);
    animation: nebulaDrift 40s ease-in-out infinite alternate;
  }

  @keyframes starDrift {
    0% { transform: translateX(0) translateY(0); }
    100% { transform: translateX(-50px) translateY(-30px); }
  }

  @keyframes twinkle {
    0% { opacity: 0.3; }
    100% { opacity: 1; }
  }

  @keyframes nebulaDrift {
    0% { transform: scale(1) translateX(0); opacity: 0.5; }
    100% { transform: scale(1.05) translateX(2%); opacity: 0.7; }
  }

  /* === ТЕРМИНАЛ === */
  .terminal-section {
    max-width: 900px;
    margin: 0.5rem auto;
    border-radius: 12px;
    overflow: hidden;
    font-family: 'Courier New', 'Fira Code', monospace;
    border: 1px solid #1e3a5f;
  }

  .terminal-header {
    padding: 0.8rem 1rem;
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid #1e3a5f;
    align-items: center;
  }

  .terminal-controls {
    display: flex;
    gap: 0.5rem;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .control.red { background: #ff5f56; }
  .control.yellow { background: #ffbd2e; }
  .control.green { background: #27c93f; }

  .terminal-title {
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .terminal-body {
    backdrop-filter: blur(4px);
    padding: 1.5rem;
    border-bottom: 1px solid #1e3a5f;
    min-height: 240px;
    -webkit-text-fill-color: currentColor;
    position: relative;
  }

  .terminal-line {
    margin-bottom: 0.8rem;
  }

  .prompt {
    font-weight: bold;
    margin-right: 0.5rem;
  }

  .terminal-output {
    margin: 0;
  }

  .tech-grid {
    display: grid;
    gap: 0.4rem 1rem;
  }

  .tech-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .tech-name {
    flex: 1;
    font-weight: 500;
  }

  .blink {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* === MATRIX-ЭФФЕКТЫ === */
  .is-hidden {
    display: none;
  }

  .terminal-line.matrix-line {
    margin-bottom: 0.4rem;
  }

  .terminal-line .matrix-typed,
  .matrix-typed {
    font-family: 'Courier New', monospace;
    letter-spacing: 1px;
    color: #27c93f !important;
    -webkit-text-fill-color: #27c93f !important;
    text-shadow: 0 0 8px rgba(39, 201, 63, 0.9), 0 0 2px rgba(39, 201, 63, 0.6) !important;
  }

  .matrix-typed::after {
    content: '_';
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    color: inherit;
  }

  /* === SYSTEM-СТРОКИ (голубые) === */
  .terminal-line.type-system .matrix-typed {
    color: #60a5fa !important;
    -webkit-text-fill-color: #60a5fa !important;
    text-shadow: 0 0 8px rgba(96, 165, 250, 0.9), 0 0 2px rgba(96, 165, 250, 0.6) !important;
  }

  /* === DIM (многоточие-пауза) === */
  .terminal-line.type-dim .matrix-typed {
    color: rgba(148, 163, 184, 0.8) !important;
    -webkit-text-fill-color: rgba(148, 163, 184, 0.8) !important;
    text-shadow: none !important;
  }

  /* === КОМАНДА === */
  .command-typed::after {
    content: '_';
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    color: #27c93f !important;
    -webkit-text-fill-color: #27c93f !important;
  }

  .command-line.done .command-typed::after {
    content: '';
  }

  /* === ПРОГРЕСС-БАР === */
  .progress-line {
    margin-bottom: 0.8rem;
  }

  .progress-typed {
    color: #27c93f !important;
    -webkit-text-fill-color: #27c93f !important;
    font-family: 'Courier New', monospace;
    letter-spacing: 0.5px;
    text-shadow: 0 0 8px rgba(39, 201, 63, 0.9) !important;
  }

  /* === ГЛИТЧ === */
  .terminal-body.glitching,
  .terminal-title.glitching {
    animation: glitchShake 0.4s steps(2) 1;
  }

  .terminal-body.glitching::before,
  .terminal-body.glitching::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .terminal-body.glitching::before {
    background: rgba(96, 165, 250, 0.12);
    transform: translateX(-3px);
    animation: glitchSlice 0.4s steps(3) 1;
  }

  .terminal-body.glitching::after {
    background: rgba(39, 201, 63, 0.12);
    transform: translateX(3px);
    animation: glitchSlice 0.4s steps(3) 1 reverse;
  }

  @keyframes glitchShake {
    0%   { transform: translate(0, 0); filter: none; }
    20%  { transform: translate(-2px, 1px); filter: hue-rotate(-25deg) saturate(1.4); }
    40%  { transform: translate(2px, -1px); filter: hue-rotate(25deg) saturate(1.4); }
    60%  { transform: translate(-1px, 1px); filter: hue-rotate(-15deg); }
    80%  { transform: translate(1px, -1px); filter: hue-rotate(15deg); }
    100% { transform: translate(0, 0); filter: none; }
  }

  @keyframes glitchSlice {
    0%   { clip-path: inset(10% 0 80% 0); }
    25%  { clip-path: inset(50% 0 30% 0); }
    50%  { clip-path: inset(20% 0 60% 0); }
    75%  { clip-path: inset(70% 0 10% 0); }
    100% { clip-path: inset(0 0 0 0); }
  }

  /* Появление сетки */
  .terminal-output {
    animation: techReveal 0.5s ease-out;
  }

  @keyframes techReveal {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tech-item {
    opacity: 0;
    animation: techItemIn 0.35s ease-out forwards;
  }

  @keyframes techItemIn {
    from { opacity: 0; transform: translateX(-8px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* === NO-ANIM: полностью отключает анимации терминала для повторного визита === */
  .no-anim,
  .no-anim * {
    animation: none !important;
    transition: none !important;
  }

  .no-anim .terminal-output {
    opacity: 1 !important;
    transform: none !important;
  }

  .no-anim .tech-item {
    opacity: 1 !important;
    transform: none !important;
  }

  /* === СТАТУС-БАР === */
  .terminal-footer {
    padding: 0.6rem 1rem;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.7rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Courier New', monospace;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .status-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* === HERO === */
  .hero {
    padding: 1rem 1rem;
    max-width: 1200px;
    margin: 60px auto 0;
  }

  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .hero-text {
    flex: 1;
    min-width: 280px;
  }

  .hero-image {
    flex-shrink: 0;
  }

  .hero-image img {
    border-radius: 50%;
    box-shadow: 0 0 30px rgba(59, 130, 246, 0.3);
    object-fit: cover;
  }

  .greeting {
    display: inline-block;
    font-size: 1rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  h1 {
    font-size: 4rem;
    margin: 0 0 0.5rem 0;
    background-clip: text;
    -webkit-background-clip: text;
    line-height: 1.2;
  }

  .description {
    font-size: 1.2rem;
    line-height: 1.6;
    height: 94px;
  }

  /* === АДАПТИВ === */
  @media (max-width: 420px) {
    .terminal-title { letter-spacing: 0.2px; }
  }

  @media (max-width: 768px) {
    .hero { padding: 1rem; }
    .hero-content {
      flex-direction: column-reverse;
      text-align: center;
    }
    h1 { font-size: 2.5rem; }
    .description { font-size: 1rem; }
    .hero-image img { width: 200px; height: 200px; }
    .tech-grid { grid-template-columns: 1fr; }
  }

  /* === FALLBACK: prefers-reduced-motion === */
